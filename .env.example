TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_URL=
ALLOWED_CHAT_ID=

MQTT_URL=
MQTT_USER=
MQTT_PASS=
MQTT_COMMAND_TOPIC=elshodlampa/device-1/cmd
MQTT_STATUS_TOPIC=elshodlampa/device-1/status
MQTT_MOTION_TOPIC=elshodlampa/device-1/motion

# Optional: protect HiveMQ/other HTTP ingest into Netlify. If omitted, TELEGRAM_SECRET_TOKEN is used.
HIVEMQ_INGEST_SECRET=

# Optional MQTT timeouts for Netlify functions.
MQTT_CONNECT_TIMEOUT_MS=8000
MQTT_PUBLISH_TIMEOUT_MS=12000

# Optional Telegram sticker file_id sent before motion alerts.
TELEGRAM_MOTION_STICKER_ID=
